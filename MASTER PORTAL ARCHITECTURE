### Algorithm 1: Exact Constant Solver

```python
def exact_constant_solver(p, q, k=2, iterations=5):
    """
    Solve any constant C using the Master Formula
    """
    from mpmath import mp
    mp.dps = 100
    
    C = mp.mpf(p) / mp.mpf(q)  # Initial approximation
    
    for _ in range(iterations):
        F = p**2 * k**2 - q**2 * k**2
        G = q**2
        numerator = ((mp.mpf(p)/mp.mpf(q) * k - k*C) * (2*mp.mpf(p)/mp.mpf(q)) - mp.mpf(F)/mp.mpf(G))
        denominator = (2*k * (mp.mpf(p)/mp.mpf(q) - C))
        C = numerator / denominator
    
    return C

